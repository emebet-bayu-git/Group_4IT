{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install backend dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--prefix",
				"backend"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check backend startup syntax",
			"type": "shell",
			"command": "node",
			"args": [
				"--check",
				"backend/server.js"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Generate bcrypt demo hash",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"console.log(require('./backend/node_modules/bcryptjs').hashSync('password123', 10))"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Generate valid bcrypt seed hash",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"console.log(require(\"bcryptjs\").hashSync(\"password123\",10))"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run bcrypt hash generator script",
			"type": "shell",
			"command": "node",
			"args": [
				".bcrypt-demo.cjs"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check database module syntax",
			"type": "shell",
			"command": "node",
			"args": [
				"--check",
				"backend/config/db.js"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Apply school database schema",
			"type": "shell",
			"command": "node",
			"args": [
				".apply-school-schema.cjs"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Retry applying school database schema",
			"type": "shell",
			"command": "node",
			"args": [
				".apply-school-schema.cjs"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Create remaining gallery table",
			"type": "shell",
			"command": "node",
